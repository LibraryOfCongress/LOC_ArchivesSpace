<% Array(note['content']).each do |content| %>
  <%= process_mixed_content(content) %>
  <br/>
<% end %>

<ul class="index">
  <% Array(note['items']).each do |index_item| %>
    <li>
    <% if index_item['reference'] %>
      <a href="#<%= index_item['reference'] %>"><%= process_mixed_content( index_item['value'] ) %></a>
    <% else %>
      <%= process_mixed_content( index_item['value'] ) %>
    <% end %>
    </li>
  <% end %>
</ul>
