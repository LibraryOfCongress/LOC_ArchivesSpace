<% if note['title'] %>
  <h4><%= note['title'] %></h4>
<% end %>
<table class="chronlist">
  <% Array(note['items']).each do |item| %>
  <tr>
    <th>
      <% if item['date_singular'] %>
      <%= item['date_singular'] %>
      <% elsif item['date_from'] || item['date_to'] %>
      <%= item['date_from'] %> - <%= item['date_to'] %>
      <% end %>
      <% if item['place'] %><br />
	<%= process_mixed_content(item['place']).gsub(/\n/, "<br />") %>
      <% end %>
    </th>
    <td>
      <% item['events'].each do | event | %>
	<%=  process_mixed_content(event) %><br />
      <% end %>
    </td>
  </tr>
  <% end %>
</table>
